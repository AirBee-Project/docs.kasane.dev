<style>
	.data-model-figure {
		margin-block: 1.5rem;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--sl-font);
	}
	text {
		fill: #000;
	}
	/* サイト全体の CSS が tspan に文字サイズを当てるので、親の text から引き継がせる */
	.data-model-figure :global(tspan) {
		font-size: inherit;
		font-weight: inherit;
	}
	.outer {
		fill: #e6e6e6;
	}
	.card {
		fill: #fff;
	}
	.rule {
		stroke: #3a3a3a;
		stroke-width: 0.5px;
	}
	.cls-1 {
		font-size: 14.82px;
		font-weight: 600;
	}
	.cls-2 {
		font-size: 16.12px;
		font-weight: 600;
	}
	.cls-5 {
		font-size: 9.02px;
		font-weight: 400;
	}
	.cls-7 {
		font-size: 10.92px;
		font-weight: 500;
	}
	.cls-12 {
		letter-spacing: -0.08em;
	}
	.cls-13 {
		letter-spacing: -0.11em;
	}
	.cls-14,
	.cls-15,
	.cls-17 {
		letter-spacing: -0.02em;
	}
	.cls-16 {
		letter-spacing: -0.01em;
	}
	.cls-18,
	.cls-19,
	.cls-20 {
		letter-spacing: -0.03em;
	}

	/* ダークモードでは、明るい箱が浮かないようにテーマの色に合わせる */
	:global([data-theme='dark']) text {
		fill: var(--sl-color-white);
	}
	:global([data-theme='dark']) .outer {
		fill: var(--sl-color-gray-6);
	}
	:global([data-theme='dark']) .card {
		fill: var(--sl-color-black);
	}
	:global([data-theme='dark']) .rule {
		stroke: var(--sl-color-gray-4);
	}
</style>
