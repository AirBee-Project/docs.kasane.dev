---
import { Code } from '@astrojs/starlight/components';

interface Props {
	code: string;
	title: string;
	lang?: string;
}
const { code, title, lang = 'ts' } = Astro.props;
const shown = code.replace(/^import type \{ Tutorial \} from "(\.\.\/)+runner";\n/m, '').replace(/\}: Tutorial\)/, '})');
---

<Code code={shown} lang={lang} title={title} />
