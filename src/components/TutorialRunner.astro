---
interface Props {
	step: string;
}
const { step } = Astro.props;
---

<div class="tutorial-runner not-content" data-step={step}>
	<button type="button" class="tutorial-run">実行する</button>
	<pre class="tutorial-output" hidden></pre>
</div>

<script>
	import type { Line, Step } from '../tutorial/runner';

	const steps = import.meta.glob<{ default: Step }>('../tutorial/steps/**/*.ts');

	for (const root of document.querySelectorAll<HTMLElement>('.tutorial-runner')) {
		const button = root.querySelector<HTMLButtonElement>('.tutorial-run')!;
		const output = root.querySelector<HTMLPreElement>('.tutorial-output')!;

		button.addEventListener('click', async () => {
			output.hidden = false;
			output.replaceChildren();
			const write = (line: Line) => {
				const span = document.createElement('span');
				span.className = `line-${line.kind}`;
				span.textContent = `${line.text}\n`;
				output.append(span);
			};
			button.disabled = true;
			button.textContent = '実行中…';
			try {
				// Kasane（Wasm）は大きいので、ボタンを押したときに読み込む
				const { runStep } = await import('../tutorial/runner');
				await runStep(root.dataset.step!, steps, write);
			} catch (e) {
				write({ kind: 'error', text: `読み込みに失敗しました。ページを再読み込みしてください。（${e instanceof Error ? e.message : String(e)}）` });
			} finally {
				button.disabled = false;
				button.textContent = 'もう一度実行する';
			}
		});
	}
</script>

<style>
	.tutorial-runner {
		margin-top: 1rem;
	}
	.tutorial-run {
		padding: 0.4rem 1rem;
		border: 0;
		border-radius: calc(var(--radius) - 2px);
		background: var(--brand);
		color: var(--brand-contrast);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.tutorial-run:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.tutorial-output {
		margin-top: 0.75rem;
		padding: 1rem;
		border-radius: calc(var(--radius) - 2px);
		background: var(--secondary);
		font-family: var(--__sl-font-mono);
		font-size: 0.85rem;
		line-height: 1.6;
		white-space: pre-wrap;
		overflow-x: auto;
	}
	.tutorial-output :global(.line-error) {
		color: #f85149;
	}
</style>
